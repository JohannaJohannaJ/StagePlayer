<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="#000000" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:id="@+id/mainLayout" android:orientation="vertical" android:padding="8dp" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:id="@+id/topbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <TextView android:id="@+id/title" android:text="StagePlayer" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
  <Button android:id="@+id/btnManage" android:text="Spellistor" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <Button android:id="@+id/btnImport" android:text="Importera" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <Button android:id="@+id/btnAttach" android:text="Text" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
  <Button android:id="@+id/btnStage" android:text="Scenläge" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
 </LinearLayout>
 <TextView android:id="@+id/playlistLabel" android:text="Alla låtar" android:textColor="#AAAAAA" android:textSize="16sp" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="3dp"/>
 <TextView android:id="@+id/stageState" android:text="STANDBY" android:textColor="#AAAAAA" android:textSize="14sp" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <TextView android:id="@+id/nextTrack" android:text="Nästa: –" android:textColor="#777777" android:textSize="14sp" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <TextView android:id="@+id/track" android:text="Ingen låt vald" android:textColor="#FFFFFF" android:textSize="27sp" android:gravity="center" android:maxLines="2" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.65"/>
 <ScrollView android:id="@+id/textScroll" android:background="#111111" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2.6">
  <TextView android:id="@+id/textView" android:text="Ingen text kopplad." android:textColor="#FFFFFF" android:textSize="25sp" android:lineSpacingExtra="8dp" android:padding="22dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 </ScrollView>
 <LinearLayout android:id="@+id/textTools" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center">
  <Button android:id="@+id/fontDown" android:text="A−" android:textSize="18sp" android:layout_width="65dp" android:layout_height="52dp"/>
  <Button android:id="@+id/fontUp" android:text="A+" android:textSize="18sp" android:layout_width="65dp" android:layout_height="52dp"/>
  <Button android:id="@+id/btnText" android:text="Text" android:layout_width="80dp" android:layout_height="52dp"/>
  <Button android:id="@+id/btnResetScroll" android:text="↥" android:textSize="20sp" android:layout_width="65dp" android:layout_height="52dp"/>
 </LinearLayout>
 <SeekBar android:id="@+id/seek" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <LinearLayout android:id="@+id/transport" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center">
  <Button android:id="@+id/prev" android:text="◀◀" android:textSize="21sp" android:layout_width="78dp" android:layout_height="68dp"/>
  <Button android:id="@+id/play" android:text="▶" android:textSize="26sp" android:layout_width="100dp" android:layout_height="68dp"/>
  <Button android:id="@+id/stop" android:text="■" android:textSize="21sp" android:layout_width="78dp" android:layout_height="68dp"/>
  <Button android:id="@+id/next" android:text="▶▶" android:textSize="21sp" android:layout_width="78dp" android:layout_height="68dp"/>
 </LinearLayout>
 <Switch android:id="@+id/autoNext" android:text="Nästa automatiskt" android:textColor="#FFFFFF" android:checked="false" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
<!-- Minimal always-available exit in stage mode -->
<Button android:id="@+id/stageExit" android:text="Redigera" android:textSize="12sp" android:alpha="0.65" android:visibility="gone" android:layout_gravity="top|end" android:layout_margin="8dp" android:layout_width="82dp" android:layout_height="42dp"/>
</FrameLayout>
